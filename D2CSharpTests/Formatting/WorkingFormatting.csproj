<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Die Dateien werden ausdrücklich unten eingebunden. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Das Projekt dient nur als Roslyn-Workspace für dotnet format. -->
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\TargetWorking\Tests\**\*.cs">
      <Link>Tests\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\..\TargetWorking\UserCode\**\*.cs">
      <Link>UserCode\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
